# "mock" runs an in-browser implementation of the API (no backend needed).
# "http" talks to the real backend (baec-portfolio-api, see its docs/api.md).
VITE_API_MODE=mock
VITE_API_BASE_URL=/ms/sudous/api/v1
# Dev-server proxy target for /ms/sudous/api/* (http mode only)
API_PROXY_TARGET=http://127.0.0.1:12000
